# Postgres (runs in docker-compose db service on EC2 #1)
POSTGRES_USER=farmwith
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=farmwith
DATABASE_URL=postgresql://farmwith:change-me-strong-password@db:5432/farmwith

# Core API secrets
JWT_SECRET_KEY=change-me
SESSION_SECRET_KEY=another-change-me
# Remember-me sessions (days)
REMEMBER_ME_EXPIRE_DAYS=30

# Frontend/backend urls plus API URL baked into the frontend build
FRONTEND_URL=https://farmwith.in
BACKEND_URL=https://api.farmwith.in
API_BASE_URL=https://api.farmwith.in
ALLOWED_ORIGINS=https://farmwith.in,http://localhost:5173

# Toggle SSO (true/false)
ENABLE_SSO=false
OIDC_PROVIDER_NAME=Authentik

# OIDC discovery URL — set after creating the FarmWith app in Authentik (slug: farmwith)
# OIDC_CONFIGURATION_URL=https://auth.cloudease.in/application/o/farmwith/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CONFIGURATION_URL=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_LOGOUT_URL=

# Amazon SES SMTP settings for password reset / verification emails
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=admin@farmwith.in
SMTP_USE_TLS=true

# Email where contribution / inquiry notifications are delivered
CONTRIBUTION_INBOX=admin@farmwith.in
SMTP_CONTRIBUTION_INBOX=admin@farmwith.in
